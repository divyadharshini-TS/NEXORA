# Development environment variables for NEXORA backend
# Copy this file to .env and replace placeholder values.

# Server
PORT=3001

# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexora?retryWrites=true&w=majority
MONGODB_URI=

# JWT secret used to sign authentication tokens (set a strong secret in production)
JWT_SECRET=change-this-to-a-strong-secret

# (Optional) Gemini API key for Phase 3
GEMINI_API_KEY=
